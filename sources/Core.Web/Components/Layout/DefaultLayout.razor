@inherits LayoutComponentBase

<div class="container-fluid p-0 m-0">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <div class="d-inline-flex align-items-baseline justify-content-end navbar-brand">
                <!-- change span later to img and provide the image-->
                <span class="bi bi-house p-2 fs-3 text-light"></span>
                <a class="fs-4 text-decoration-none text-light" href="/">SchoolTraining</a>
            </div>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            @Resx.Core.LabelAdministration
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="navbarDropdown">
                            <li>
                                <NavLink class="dropdown-item text-light" href="/administration/family-and-user-administration">@Resx.Core.LabelFamilyAndUserAdministration</NavLink>
                            </li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/about">About</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/contact">Contact</NavLink>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        @Body
    </div>
    <div id="blazor-error-ui" data-nosnippet>
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    </div>
</div>

<script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>



