@page "/"
@rendermode InteractiveServer
@layout AuthenticationLayout
@using System.ComponentModel.DataAnnotations
@using Core.Web.Components.Pages.ViewModels

@inherits ViewModelComponentBase<AuthenticationViewModel>

<div class="form w-25 p-5 rounded-3 opacity-75">
    <EditForm Model="@ViewModel.LoginModel" OnValidSubmit="@ViewModel.SignInAsync" FormName="LoginForm">
        <DataAnnotationsValidator />
        <div class="mt-4">
            <img class="form-image" src="/img/dotnet_bot.png" alt="login image" />
        </div>
        <div class="ps-5 mb-2">
            <h2 class="mb-2">Anmeldung</h2>
        </div>
        <div class="mb-3 form-group">
            <label class="form-label ps-2 fs-6" for="username">Benutzername</label>
            <InputText id="username" type="text" class="form-control bg-secondary"  @bind-Value="ViewModel.LoginModel.UserName" />
        </div>
        <div class="mb-3 form-group">
            <label class="form-label ps-2 fs-6" for="password">Password</label>
            <InputText id="password" type="password" class="form-control bg-secondary" @bind-Value="ViewModel.LoginModel.Secret" />
        </div>
        <div class="form-check mb-3">
            <input type="checkbox" class="form-check-input fs-6" id="remember" @bind-value="@ViewModel.LoginModel.Remember">
            <label class="form-check-label fs-6" for="remember">Logindaten merken</label>
        </div>
        <div class="d-flex justify-content-end p-2">
            <button type="submit" class="btn btn-primary">Anmelden</button>
        </div>
    </EditForm>
</div>

