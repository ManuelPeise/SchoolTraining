@inherits LayoutComponentBase

<div class="app-root">
    <header class="app-header" style="padding:16px 24px; border-bottom: 1px solid rgba(255,255,255,0.03);">
        <div class="app-container">
            <h1>Meine App</h1>
        </div>
    </header>

    <main class="app-container" role="main">
        @Body
    </main>

    <footer style="padding:16px 24px; margin-top:auto; border-top:1px solid rgba(255,255,255,0.03);">
        <div class="app-container" style="font-size:0.9rem; color:var(--disabled-text);">
            © @DateTime.Now.Year
        </div>
    </footer>
</div>
