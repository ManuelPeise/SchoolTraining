<li>
    <div class="side-menu-item @IsDisabled ? disabled : null" @onclick="@ToggleExpanded" aria-disabled="@IsDisabled">
        <span class="@IconClass menu-icon"></span>
        <label class="menu-label">@Label</label>
    </div>
    @if (IsExpanded)
    {
        <ul>
            @for(int i = 0; i < SubItems.Count; i++)
            {
                <li>
                    <div class="side-menu-item" @onclick="@SubItems[i].Navigate">
                        <span class="menu-icon-placeholder"></span>
                        <label class="menu-label">@SubItems[i].Label</label>
                    </div>
                </li>
            }
        </ul>
    }
</li>