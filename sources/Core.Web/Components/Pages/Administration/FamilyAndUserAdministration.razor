@page "/administration/family-and-user-administration"
@using Core.Web.Components.Pages.ViewModels
@inherits ViewModelComponentBase<FamilyAndUserAdministrationViewModel>
@inject IJSRuntime JS

<div id="page" class="container-fluid pt-2">
    <LoadingOverlay IsLoading="@ViewModel.IsLoading" />
    <div id="header" class="w-100 p-3 border rounded">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex flex-column flex-grow-1 min-w-0 me-3">
                <h2 class="text-truncate mb-1" title="Family and User Administration" data-bs-toggle="tooltip">Family and User Administration</h2>
                <p class="text-muted mb-0 text-truncate" title="Manage families and users by downloading the template or uploading your file." data-bs-toggle="tooltip">Manage families and users by downloading the template or uploading your file.</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-secondary" title="File download" aria-label="File download" @onclick="DownloadFile">
                    <span class="bi bi-arrow-down-circle"></span>
                    <span>Download</span>
                </button>
                <label class="btn btn-secondary" title="File upload" for="family-template-file-selector" aria-label="File upload" role="button">
                    <InputFile id="family-template-file-selector" OnChange="@ViewModel.HandleSelectFile" hidden />
                    <span class="bi bi-arrow-up-circle"></span>
                    <span>Upload</span>
                </label>
                <div class="switch-column">
                    <div class="form-check form-switch d-inline-flex align-items-center">
                        <input id="is-active" type="checkbox" class="form-check-input" checked="@ViewModel.SelectedFamily.Model?.IsActive" />
                        <label class="form-check-label ms-2" for="is-active">Active</label>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="content" class="d-flex gap-3">
        <div class="w-25 mt-3 p-3 border rounded d-flex flex-column">
            <ul class="list-unstyled w-100">
                <li class="w-100">
                    <div class="w-100 p-2">
                        <label class="form-label ps-2 fs-6" for="search-text">@Resx.Core.LabelSearch</label>
                        <input id="search-text" type="text" class="form-control" @oninput="@ViewModel.OnFilterTextChanged" />
                    </div>
                </li>
            </ul>
            <div class="family-list flex-grow-1 overflow-auto">
                <ul class="list-unstyled list-group mb-0">
                    @foreach (var item in ViewModel.FamilyListItems)
                    {
                        <li id="@item.Id" @onclick="() => ViewModel.OnSelectFamily(item.Id)" class="family-item @item.ClassName">
                            <div>
                                <h5 class="mb-1 fs-6 text-truncate">@item.Model?.Name</h5>
                                <span class="text-muted text-truncate d-block">@item.Model?.ContactMailAddress</span>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
        <div class="w-100 mt-3 p-3 border rounded">

            @if (ViewModel.SelectedFamily.Model == null)
            {
                <div class="text-muted">No family selected</div>
            }
            else
            {
                <div id="family-container" class="family-container p-3">
                    <div class="family-header">
                        <div class="family-info min-w-0 me-3">
                            <h3 class="mb-0 text-truncate">@ViewModel.SelectedFamily.Model?.Name</h3>
                            <small class="text-muted">@ViewModel.SelectedFamily.Model?.ContactMailAddress</small>
                        </div>
                        <div class="switch-column">
                            <div class="form-check form-switch d-inline-flex align-items-center">
                                <input id="is-active-header" type="checkbox" class="form-check-input" checked="@ViewModel.SelectedFamily.Model?.IsActive" />
                                <label class="form-check-label ms-2" for="is-active-header">Active</label>
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div id="family-members" class="members-list">
                        @if (ViewModel.SelectedFamily.Model != null &&
                            ViewModel.SelectedFamily.Model.Members != null &&
                            ViewModel.SelectedFamily.Model.Members.Any())
                        {
                            @foreach (var member in ViewModel.SelectedFamily.Model.Members)
                            {
                                <div id="@member.UserId" class="member-item">
                                    <div class="member-info min-w-0">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="bi bi-person-circle fs-4"></span>
                                            <div class="min-w-0">
                                                <h5 class="mb-0 fs-6 text-truncate">@member.UserName</h5>
                                                <small class="text-muted text-truncate d-block">@member.Email</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="switch-column">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="text-muted">@member.UserRole</span>
                                            <div class="form-check form-switch d-inline-flex align-items-center">
                                                <input id="is-active-@member.UserId" type="checkbox" class="form-check-input" checked="@member.IsActive" />
                                                <label class="form-check-label ms-2" for="is-active-@member.UserId">Active</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>

</div>
<script src="/js/FileImport.js"></script>
@code {

    private async Task DownloadFile()
    {
        var fileResult = await ViewModel.GetFileFromServer();

        if (fileResult == null || fileResult?.FileName == null)
        {
            return;
        }

        await JS.InvokeVoidAsync("downloadFamilyTemplateFile", fileResult.FileName, fileResult.FileContent);
    }
}
